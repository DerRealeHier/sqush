# Flask Configuration
SECRET_KEY=replace_with_a_secure_random_key_in_production
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL (e.g., Supabase / Neon / self-hosted):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PLATFORM_FEE_PERCENT=10.0
DEV_PAYOUT_PERCENT=90.0
TIP_PLATFORM_FEE_PERCENT=0.0

# Mail (Gmail SMTP or SendGrid/Resend)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Firebase Auth
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Hack Club OAuth (optional)
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
HACKCLUB_REDIRECT_URI=http://127.0.0.1:5000/auth/hackclub/callback

# Cloudflare R2 Storage (10 GB Free, $0 Egress fees for game downloads)
# Find these in Cloudflare Dashboard -> R2 -> Overview / Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sqush-games
# Optional: Public URL (e.g., https://cdn.sqush.io or https://pub-<id>.r2.dev)
R2_PUBLIC_URL=

# Cloudflare Turnstile (Free Bot Protection for Login/Register)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ClamAV Antivirus (optional)
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
